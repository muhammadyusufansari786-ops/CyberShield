[TEMPLATE]
# CyberShield backend configuration
# Copy this file to .env and fill in your real key (never commit .env).

# Required for all AI features.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_KEY_HERE

# Optional overrides (defaults are built into server/services/gemini.js)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------
# HTTP server (optional - sane defaults are built into server/server.js)
# ------------------------------------------------------------------

# Port the server listens on (default: 3000)
# PORT=3000
# Interface address (default: 127.0.0.1 = local machine only). Set a
# public address only when you intentionally want to expose the server.
# HOST=127.0.0.1
# Set to "production" when deploying. This enables secure session cookies
# and makes SESSION_SECRET mandatory (fail-fast on startup).
# NODE_ENV=development

# ------------------------------------------------------------------
# Sessions
# ------------------------------------------------------------------

# REQUIRED in production (32+ characters, unique per deployment).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development it may stay unset: a random secret is then generated and
# saved to server/config/.session-secret (gitignored) so logins survive
# server restarts.
# SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS

# Optional: session cookie name override (default: cybershield.sid).
# Allowed characters: letters, digits, underscore, dash - 1 to 64 chars.
# SESSIONNAME=cybershield.sid

# ------------------------------------------------------------------
# Database (REQUIRED - the server refuses to start without it)
# ------------------------------------------------------------------

# MongoDB Atlas connection string. Create a free cluster at
# https://cloud.mongodb.com and add your current IP under Network Access
# (startup fails fast with a clear message if the IP is not whitelisted).
# The "cybershield" database name is applied automatically - do not add a
# database name to the URI path. All accounts, sessions and user data are
# stored here.
# MONGODB_URI=mongodb+srv://<dbUser>:<dbPassword>@<your-cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Dev-only escape hatch: start the server WITHOUT the database so the site
# stays viewable; /api/auth/* and /api/dashboard then return 503 until the
# real connection works. Never set this in production.
# DEV_NO_DB=1
